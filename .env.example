# Copy to .env (never commit .env)
SARVAM_API_KEY=
# Optional overrides
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anand
# Optional: CP Plus / any RTSP or snapshot camera for Weed Watch (laptop only), e.g.
# CAM_URL=rtsp://admin:PASSWORD@192.168.1.64:554/cam/realmonitor?channel=1&subtype=1
# or the Dahua-style snapshot: CAM_URL=http://admin:PASSWORD@192.168.1.64/cgi-bin/snapshot.cgi
# or a video file to rehearse: CAM_URL=/path/to/lake.mp4
# CAM_URL is re-read live from .env, no restart needed.
CAM_URL=
CAM_PLACE=punnamada
# Optional fixed spot for camera reports (the boat's mooring), e.g. 9.5135 / 76.3480
CAM_LAT=
CAM_LNG=

# Public base URL for the phone QR code (tunnel to this laptop), e.g. https://xyz.trycloudflare.com
PUBLIC_URL=
