# Copy to .env (never commit .env)
SARVAM_API_KEY=
# Optional overrides
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anand
# Optional: CP Plus / any RTSP or snapshot camera for Weed Watch (laptop only), e.g.
# CAM_URL=rtsp://admin:PASSWORD@192.168.1.64:554/cam/realmonitor?channel=1&subtype=1
CAM_URL=
CAM_PLACE=punnamada

# Public base URL for the phone QR code (tunnel to this laptop), e.g. https://xyz.trycloudflare.com
PUBLIC_URL=
